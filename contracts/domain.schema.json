{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "主题雕塑创作会审领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CLAIM_SUBMITTED",
        "CLAIM_CORRECTED",
        "CLAIM_WITHDRAWN",
        "EXPERT_OPINION_RECORDED",
        "DESIGN_SUBMITTED",
        "DESIGN_DECISION_RECORDED",
        "COMPONENT_REGISTERED",
        "COMPONENT_FROZEN",
        "COMPONENT_UNFROZEN",
        "WORK_ORDER_ISSUED",
        "INSPECTION_RECORDED",
        "QUARANTINE_RECORDED",
        "CORRECTIVE_ACTION_RECORDED",
        "COMPONENT_REWORK_STARTED",
        "COMPONENT_REPLACED",
        "BATCH_REGISTERED",
        "COMPONENT_ASSIGNED_BATCH",
        "MATERIAL_TEST_RECORDED",
        "BATCH_QUARANTINED",
        "PROPAGATION_HOLD_OPENED",
        "DISPOSITION_CONFIRMED",
        "HOLD_RESOLVED",
        "RELEASE_REJECTED",
        "INSTALLATION_CLEARED",
        "LABEL_RELEASED",
        "IDEMPOTENCY_RECORDED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "historical_claim",
        "expert_opinion",
        "design_version",
        "component",
        "fabrication_batch",
        "propagation_hold",
        "installation_release",
        "idempotency_record"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "description": "事件载荷，结构随 event_type 而定；史实证据与艺术推断在载荷的 kind 字段分开标记。"
    }
  },
  "additionalProperties": true
}
